generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  salt         String
  avatarUrl    String?
  otpEnabled   Boolean        @default(true)
  otpHash      String?
  otpExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  otps         AdminOtp[]

  @@map("admin_users")
}

model AdminSession {
  id        String     @id @default(uuid())
  token     String     @unique
  email     String
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [email], references: [email])

  @@index([email])
  @@map("admin_sessions")
}

model AdminOtp {
  id        String     @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [email], references: [email])

  @@index([email])
  @@map("admin_otps")
}

model Customer {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  salt         String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     CustomerSession[]

  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(uuid())
  token      String   @unique
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

model IpBlock {
  id           String    @id @default(uuid())
  ip           String    @unique
  attempts     Int       @default(0)
  blockedAt    DateTime?
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("ip_blocks")
}

model SecurityCode {
  id         String    @id @default(uuid())
  label      String    @default("Verification code")
  codeHash   String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  @@map("security_codes")
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String?
  author    String   @default("InfiniSoft Team")
  cover     String?
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blogs")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model Lead {
  id             String      @id @default(uuid())
  leadNumber     String?
  name           String?
  email          String?
  phone          String?
  companyId      String?
  company        Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  subject        String?
  service        String?
  message        String?
  source         String      @default("Contact form")
  status         String      @default("New")
  estimatedValue Float?
  ownerId        String?
  ownerName      String?
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime    @default(now())
  insertedAt     DateTime    @default(now())
  replies        LeadReply[]

  @@map("leads")
}

model LeadReply {
  id        String   @id @default(uuid())
  leadId    String
  body      String
  direction String   @default("outgoing")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_replies")
}

model Message {
  id         String   @id @default(uuid())
  content    String
  username   String?
  insertedAt DateTime @default(now())

  @@map("messages")
}

model Company {
  id          String    @id @default(uuid())
  companyName String
  website     String?
  email       String?
  phone       String?
  industry    String?
  companySize String?
  address     String?
  city        String?
  country     String?
  notes       String?
  ownerId     String?
  ownerName   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]

  @@index([companyName])
  @@map("companies")
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  designation String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source      String   @default("Other")
  ownerId     String?
  ownerName   String?
  notes       String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([companyId])
  @@map("contacts")
}

model Deal {
  id                String    @id @default(uuid())
  dealName          String
  clientName        String?
  clientEmail       String?
  contactId         String?
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  value             Float     @default(0)
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  stage             String    @default("New")
  ownerId           String?
  ownerName         String?
  service           String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@index([companyId])
  @@map("deals")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── RBAC Users (ADMIN / DEVELOPER roles) ───────────────────────────────────

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  salt         String
  avatarUrl    String?
  role         String            @default("DEVELOPER") // SUPER_ADMIN | ADMIN | DEVELOPER
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     DeveloperSession[]
  assignedTasks Task[]           @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreator")
  taskComments  TaskComment[]
  managedProjects Project[]      @relation("ProjectManager")

  @@index([email])
  @@index([role])
  @@map("users")
}

model DeveloperSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("developer_sessions")
}

// ─── PROJECT MANAGEMENT ──────────────────────────────────────────────────────

model Project {
  id                String      @id @default(uuid())
  projectCode       String?     @unique
  name              String
  description       String?
  clientId          String?
  clientName        String?
  clientEmail       String?
  companyId         String?
  companyName       String?
  projectManagerId  String?
  projectManager    User?       @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  status            String      @default("PLANNING") // PLANNING|NOT_STARTED|IN_PROGRESS|ON_HOLD|IN_REVIEW|CLIENT_REVIEW|REVISION_REQUIRED|TESTING|DEPLOYMENT|COMPLETED|CANCELLED
  priority          String      @default("MEDIUM")   // LOW|MEDIUM|HIGH|URGENT
  health            String      @default("HEALTHY")  // HEALTHY|AT_RISK|DELAYED
  startDate         DateTime?
  expectedEndDate   DateTime?
  actualEndDate     DateTime?
  budget            Float?
  progress          Int         @default(0)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  milestones        Milestone[]
  tasks             Task[]
  files             ProjectFile[]

  @@index([status])
  @@index([clientId])
  @@map("projects")
}

model ProjectFile {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publicId     String?
  url          String
  secureUrl    String?
  fileName     String
  fileType     String?
  fileSize     Int      @default(0)
  isImage      Boolean  @default(false)
  uploadedById String?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@map("project_files")
}

model Milestone {
  id          String    @id @default(uuid())
  name        String
  description String?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String    @default("NOT_STARTED") // NOT_STARTED|IN_PROGRESS|COMPLETED|BLOCKED
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([projectId])
  @@map("milestones")
}

model Task {
  id             String        @id @default(uuid())
  taskCode       String?
  title          String
  description    String?
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeName   String?
  createdById    String?
  createdBy      User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priority       String        @default("MEDIUM")  // LOW|MEDIUM|HIGH|URGENT
  status         String        @default("TODO")    // TODO|IN_PROGRESS|IN_REVIEW|CLIENT_REVIEW|REVISION_REQUIRED|BLOCKED|COMPLETED
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  clientVisible  Boolean       @default(false)
  submissionFiles Json?
  submissionNotes String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  comments       TaskComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model Notification {
  id         String   @id @default(uuid())
  role       String   @default("ADMIN") // ADMIN | CUSTOMER | DEVELOPER
  userId     String?
  type       String   @default("INFO")
  title      String
  message    String
  entityType String?
  entityId   String?
  link       String?
  actorName  String?
  actorRole  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([role, userId])
  @@index([role, isRead])
  @@index([isRead])
  @@map("notifications")
}
